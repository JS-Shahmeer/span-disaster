# Postgres connection (Neon, Vercel Postgres, Supabase, ...).
# DATABASE_URL may be a pooled URL; DIRECT_URL must be a direct connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/span"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/span"

# Secret used to sign admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Vercel Blob token for uploading resource files and product images from the admin.
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
