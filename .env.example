# Postgres connection (Neon, Vercel Postgres, Supabase, ...).
# DATABASE_URL may be a pooled URL; DIRECT_URL must be a direct connection for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/span"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/span"

# Secret used to sign admin session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# First admin account, created by `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Optional: Vercel Blob token for uploading resource files and product images from the admin.
BLOB_READ_WRITE_TOKEN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stripe (use test keys until launch). Webhook endpoint: /api/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: a Shipping Rate id from the Stripe dashboard (e.g. flat rate), ISO country list, and Stripe Tax.
STRIPE_SHIPPING_RATE_ID=""
STRIPE_SHIPPING_COUNTRIES="US"
STRIPE_AUTOMATIC_TAX="false"

# Email notifications via Resend (https://resend.com). EMAIL_FROM must be on a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="SPAN Disaster Services <no-reply@example.org>"
NOTIFY_EMAIL=""
