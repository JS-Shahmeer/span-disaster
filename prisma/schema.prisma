generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  category         String
  description      String
  features         String[]
  // null = price not set yet, 0 = free
  priceCents       Int?
  priceNote        String?
  format           String?
  delivery         String?
  image            String?
  badge            String?
  intendedAudience String?
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published, sortOrder])
}

model Resource {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  category        String
  relatedActivity Int?
  relatedMeeting  String?
  free            Boolean  @default(true)
  placeholder     Boolean  @default(false)
  fileUrl         String?
  thumbnail       String?
  videoUrl        String?
  transcript      String?
  sortOrder       Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  inquiryType String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([read, createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}
